{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haesol-shin/omp-hermes-bridge/contract/schema/inbox-message.schema.json",
  "title": "Inbox message (Hermes to omp)",
  "description": "Written by Hermes to <root>/inbox/<session_id>/<msg_id>.json via write-to-.tmp then rename.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "msg_id",
    "kind",
    "text",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "msg_id": {
      "$ref": "#/$defs/uuid4"
    },
    "kind": {
      "enum": [
        "prompt",
        "answer"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "reply_to": {
      "$ref": "#/$defs/uuid4",
      "description": "Question id. Required when kind is answer."
    },
    "created_at": {
      "$ref": "#/$defs/utc_time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "reply_to"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reply_to"
          ]
        }
      }
    }
  ],
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "utc_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO 8601 ending in Z."
    }
  }
}
